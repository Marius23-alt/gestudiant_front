<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.miage.toulouse.front.controller.AdminSemestreController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <children>
        <VBox spacing="10.0" style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-border-color: #dee2e6; -fx-border-radius: 10; -fx-padding: 15;">
            <Label text="Panneau de Contrôle Temporel (Simulation - Ne modifie pas la BDD)" textFill="#03224C">
                <font><Font name="System Bold" size="16.0" /></font>
            </Label>
            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <ComboBox fx:id="comboAnneeSimu" prefWidth="150.0" promptText="Année Univ." />
                <ComboBox fx:id="comboSaisonSimu" prefWidth="180.0" promptText="Saison" />
                <Button mnemonicParsing="false" onAction="#handleSimulerTemps" style="-fx-background-color: #17a2b8; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="Simuler cette date" />

                <Region HBox.hgrow="ALWAYS" />

                <Label fx:id="lblHorlogeActuelle" text="Horloge actuelle de l'Université : 2024-2025 (Impair)" textFill="#6c757d">
                    <font><Font name="System Italic" size="13.0" /></font>
                </Label>
            </HBox>
        </VBox>

        <VBox spacing="15.0" VBox.vgrow="ALWAYS">
            <Label text="Étudiants en attente de traitement (Ayant des UE &quot;en cours&quot;)" textFill="#03224C">
                <font><Font name="System Bold" size="16.0" /></font>
            </Label>

            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <ComboBox fx:id="comboMention" prefWidth="150.0" promptText="Mention" />
                <ComboBox fx:id="comboParcours" prefWidth="150.0" promptText="Parcours" />
                <ComboBox fx:id="comboSemestre" prefWidth="150.0" promptText="Semestre" />

                <Region HBox.hgrow="ALWAYS" />

                <TextField fx:id="searchField" prefWidth="250.0" promptText="Rechercher un étudiant..." style="-fx-background-radius: 20; -fx-padding: 5 15;" />
            </HBox>

            <TableView fx:id="studentTable" style="-fx-border-color: #03224C; -fx-border-width: 1; -fx-background-radius: 5;" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNom" prefWidth="150.0" text="Nom" />
                    <TableColumn fx:id="colPrenom" prefWidth="150.0" text="Prénom" />
                    <TableColumn fx:id="colNumEtudiant" prefWidth="120.0" text="Num étudiant" />
                    <TableColumn fx:id="colMention" prefWidth="100.0" text="Mention" />
                    <TableColumn fx:id="colParcours" prefWidth="100.0" text="Parcours" />
                    <TableColumn fx:id="colAction" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Dossier" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>

        <VBox alignment="CENTER" spacing="5.0">
            <Button mnemonicParsing="false" onAction="#handleCloturerSemestre" style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 30; -fx-cursor: hand;" text="Clôturer définitivement le semestre">
                <font><Font name="System Bold" size="14.0" /></font>
            </Button>
            <Label text="Attention : Cette action passera toutes les UE non traitées en &quot;échouée&quot; et modifiera la Base de Données." textFill="#dc3545">
                <font><Font name="System Italic" size="12.0" /></font>
            </Label>
        </VBox>
    </children>
</VBox>
