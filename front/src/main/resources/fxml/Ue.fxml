<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="30.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.miage.toulouse.front.controller.UeController">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <children>
        <HBox alignment="CENTER" spacing="20.0">
            <children>
                <ComboBox fx:id="comboMention" prefHeight="45.0" prefWidth="180.0" promptText="Mention" style="-fx-background-color: #E0E0E0; -fx-background-radius: 10; -fx-font-weight: bold; -fx-font-size: 14px;" />
                <ComboBox fx:id="comboParcours" prefHeight="45.0" prefWidth="180.0" promptText="Parcours" style="-fx-background-color: #E0E0E0; -fx-background-radius: 10; -fx-font-weight: bold; -fx-font-size: 14px;" />
                <ComboBox fx:id="comboAnnee" prefHeight="45.0" prefWidth="180.0" promptText="Année" style="-fx-background-color: #E0E0E0; -fx-background-radius: 10; -fx-font-weight: bold; -fx-font-size: 14px;" />
            </children>
        </HBox>

        <Label fx:id="lblTitreUe" text="UE en mention MIASHS parcours MIAGE en L3" textAlignment="CENTER">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>

        <TableView fx:id="tableUe" VBox.vgrow="ALWAYS" style="-fx-border-color: black; -fx-border-width: 2;">
            <columns>
                <TableColumn fx:id="colMatiere" prefWidth="250.0" text="Matières" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT;" />

                <TableColumn text="Traitement des UE" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-alignment: CENTER;">
                    <columns>
                        <TableColumn fx:id="colInscription" prefWidth="200.0" style="-fx-alignment: CENTER;" />

                        <TableColumn fx:id="colValide" prefWidth="200.0" style="-fx-alignment: CENTER;" />
                    </columns>
                </TableColumn>
            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>