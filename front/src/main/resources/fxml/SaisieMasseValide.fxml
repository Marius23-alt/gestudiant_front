<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.miage.toulouse.front.controller.SaisieMasseValideController">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="30.0" />
    </padding>

    <children>
        <HBox alignment="CENTER_LEFT" spacing="20.0">
            <children>
                <Button fx:id="btnRetour" mnemonicParsing="false" onAction="#handleRetour" style="-fx-background-color: white; -fx-border-color: black; -fx-border-radius: 10; -fx-background-radius: 10; -fx-cursor: hand;" text="&lt; Retour">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                    <padding>
                        <Insets bottom="5.0" left="15.0" right="15.0" top="5.0" />
                    </padding>
                </Button>

                <Region HBox.hgrow="ALWAYS" />

                <Label fx:id="lblContexte" text="Étudiant en Anglais (MIAGE L3)">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>

                <Region HBox.hgrow="ALWAYS" />
            </children>
        </HBox>

        <HBox alignment="CENTER_RIGHT">
            <children>
                <CheckBox fx:id="checkAll" mnemonicParsing="false" onAction="#handleSelectAll" text="Tout sélectionner / déselectionner">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </CheckBox>
            </children>
            <VBox.margin>
                <Insets bottom="-10.0" />
            </VBox.margin>
        </HBox>

        <TableView fx:id="tableEtudiants" VBox.vgrow="ALWAYS" style="-fx-border-color: black; -fx-border-width: 2;">
            <columns>
                <TableColumn fx:id="colNom" prefWidth="250.0" text="Nom" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT;" />
                <TableColumn fx:id="colPrenom" prefWidth="250.0" text="Prénom" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT;" />
                <TableColumn fx:id="colCoche" prefWidth="100.0" text="Coché" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-alignment: CENTER;" />
            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <HBox alignment="CENTER_RIGHT">
            <children>
                <Button fx:id="btnValiderMasse" mnemonicParsing="false" onAction="#handleValiderMasse" style="-fx-background-color: #FFB300; -fx-background-radius: 15; -fx-cursor: hand;" text="Inscrire les 17 à Anglais">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                    <padding>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                    </padding>
                </Button>
            </children>
        </HBox>
    </children>
</VBox>