<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: white; -fx-padding: 30;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.miage.toulouse.front.controller.ModifierProfilController">
    <children>
        <Label text="Modifier l'étudiant" textFill="#333333">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <VBox spacing="5.0">
            <Label text="Nom :" textFill="#575757">
                <font><Font name="System Bold" size="12.0" /></font>
            </Label>
            <TextField fx:id="champNom" promptText="Nom de l'étudiant" style="-fx-background-radius: 5; -fx-padding: 8;" />
        </VBox>

        <VBox spacing="5.0">
            <Label text="Prénom :" textFill="#575757">
                <font><Font name="System Bold" size="12.0" /></font>
            </Label>
            <TextField fx:id="champPrenom" promptText="Prénom de l'étudiant" style="-fx-background-radius: 5; -fx-padding: 8;" />
        </VBox>

        <Button mnemonicParsing="false" onAction="#handleValider" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text="Valider les modifications">
            <font><Font name="System Bold" size="13.0" /></font>
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
            </padding>
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
        </Button>
    </children>
</VBox>